# Synthetic deployment inputs. Copy to an ignored .tfvars file and adapt.
name                = "vnet-example-dev-uks"
resource_group_name = "rg-example-network-dev-uks"
location            = "uksouth"
address_space       = ["10.40.0.0/16"]

subnets = {
  application = {
    address_prefixes = ["10.40.1.0/24"]
    network_security_group = {
      name = "nsg-example-application"
      rules = {
        allow-internal-https = {
          priority               = 100
          direction              = "Inbound"
          access                 = "Allow"
          protocol               = "Tcp"
          source_address_prefix  = "10.40.0.0/16"
          destination_port_range = "443"
        }
      }
    }
  }
  private-endpoints = {
    address_prefixes = ["10.40.2.0/24"]
  }
}

tags = {
  Environment = "example"
  ManagedBy   = "Terraform"
  Project     = "network-foundation"
}
