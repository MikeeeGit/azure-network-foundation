# Runtime Terraform data and potentially sensitive deployment inputs
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.plan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
*.hcl.local
backend*.hcl
**/backend*.hcl
*.pem
*.key
*.pfx
.env
.env.*
!.env.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
__pycache__/
*.pyc
# Keep provider lockfiles in version control for reproducible repository CI.

# Reviewed synthetic examples form the public configuration contract.
!config/global.tfvars
!config/uks/hub/hub.tfvars
!config/uks/pprd/pprd.tfvars
!config/uks/prd/prd.tfvars
!config/ukw/hub/hub.tfvars
!config/ukw/bcdr/bcdr.tfvars
.delivery/

# Shared helper context, saved plans and private manifests.
.terraform-delivery/

# Reviewed hub/spoke scenario configuration.
!examples/hub-spoke/config/global.tfvars
!examples/hub-spoke/config/uks/hub/hub.tfvars
!examples/hub-spoke/config/uks/pprd/pprd.tfvars
!examples/hub-spoke/config/uks/prd/prd.tfvars
